# Stage 1: Build file .jar bằng Maven
FROM maven:3.9.6-eclipse-temurin-21-alpine AS builder
WORKDIR /build

# Copy file cấu hình Maven và tải dependencies trước (để cache)
COPY backend/pom.xml .
RUN mvn dependency:go-offline -B

# Copy toàn bộ source code và tiến hành build
COPY backend/src ./src
RUN mvn clean package -DskipTests

# Stage 2: Môi trường chạy thực tế (chỉ cần JRE cho nhẹ)
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copy file .jar từ Stage 1 sang
COPY --from=builder /build/target/backend-0.0.1-SNAPSHOT.jar app.jar

# Expose port mặc định của Spring Boot
EXPOSE 8080

# Chạy ứng dụng
ENTRYPOINT ["java", "-jar", "app.jar"]